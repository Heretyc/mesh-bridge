# Required. Create the Discord application and bot with the literal name Mesh Bridge.
DISCORD_TOKEN=replace-me

# Generate with: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
IPC_TOKEN=replace-me

# All non-secret settings — IPC port, queue limits, retry counts, send pacing,
# timeouts, deduplication lifetime, and channel pairs — now live in config.jsonc
# at the repo root. Copy config.jsonc.example to config.jsonc and fill in real
# values before starting the bridge.
#
# Leaving DISCORD_CHANNEL_ID or MESHTASTIC_CHANNEL_NAME in this file causes a
# deliberate startup failure that names the offending variables.
