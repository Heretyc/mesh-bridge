# Required. Create the Discord application and bot with the literal name Mesh Bridge.
DISCORD_TOKEN=replace-me
DISCORD_CHANNEL_ID=123456789012345678
MESHTASTIC_CHANNEL_NAME=private

# Generate with: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
IPC_TOKEN=replace-me
IPC_PORT=47652

# Optional bounded reliability settings.
QUEUE_LIMIT=100
MESH_ACK_RETRIES=2
MESH_SEND_INTERVAL_MS=1000
MESH_CONFIG_TIMEOUT_MS=30000
DEDUP_TTL_MS=300000
