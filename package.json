{
  "name": "mesh-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js",
    "start": "node dist/service.js",
    "tui": "node dist/tui.js",
    "service:install": "node dist/servicectl.js install",
    "service:start": "node dist/servicectl.js start",
    "service:stop": "node dist/servicectl.js stop",
    "service:status": "node dist/servicectl.js status",
    "service:uninstall": "node dist/servicectl.js uninstall",
    "service:attach": "node dist/servicectl.js attach",
    "service:restart": "node dist/servicectl.js restart"
  },
  "dependencies": {
    "@meshtastic/core": "2.6.7",
    "@meshtastic/protobufs": "2.7.8",
    "@meshtastic/transport-node-serial": "0.0.2",
    "discord.js": "14.27.0",
    "jsonc-parser": "3.3.1",
    "serialport": "13.0.0",
    "ste-simple-events": "3.0.11",
    "tslog": "4.9.3"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.8.3"
  }
}
